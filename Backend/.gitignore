# Node
node_modules/
dist/

# Environment
# .env.example was briefly untracked here after it shipped the same literal
# JWT_SECRET value the app was actually using. That value has since been
# replaced with an obvious non-functional placeholder (see the file itself),
# so it's safe to track again — without it, nobody cloning this repo has any
# record of which env vars to set.
.env
.env.*
!.env.example

