PORT=5000
NODE_ENV=development
# Matches Backend/docker-compose.yml. Host port is 5434 because 5432/5433
# are commonly already taken by other local Postgres instances.
DATABASE_URL=postgresql://devproof:devproof_local_dev@localhost:5434/devproof_db?schema=public
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse this example value as a real secret — an earlier version of this
# line shipped the app's actual JWT_SECRET as its "example," which is why this
# file was briefly removed from git entirely (see .gitignore for the story).
JWT_SECRET=replace_with_a_generated_random_value_min_32_chars
JWT_EXPIRES_IN=7d
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback
FRONTEND_URL=http://localhost:5173

# Free key from https://console.groq.com. Without it the server still boots —
# AI insights requests just fail with a clear 503 rather than the whole app
# refusing to start.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
