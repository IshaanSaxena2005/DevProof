PORT=5000
NODE_ENV=development
# Matches Backend/docker-compose.yml. Host port is 5434 because 5432/5433
# are commonly already taken by other local Postgres instances.
DATABASE_URL=postgresql://devproof:devproof_local_dev@localhost:5434/devproof_db?schema=public
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse this example value as a real secret — an earlier version of this
# line shipped the app's actual JWT_SECRET as its "example," which is why this
# file was briefly removed from git entirely (see .gitignore for the story).
JWT_SECRET=replace_with_a_generated_random_value_min_32_chars
JWT_EXPIRES_IN=7d
# From a GitHub App (https://github.com/settings/apps), NOT an OAuth App.
# A GitHub App client id starts with Iv1. or Iv23; the server rejects anything
# else, because repositories are enumerated per installation rather than by
# OAuth scope. Authorizing only proves identity - the user must also INSTALL
# the app to grant it access to any repository.
# The callback URL registered on GitHub must exactly match GITHUB_CALLBACK_URL.
GITHUB_CLIENT_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback
# Shared secret for webhook payload verification. You invent this value and
# paste the SAME string into the GitHub App webhook settings - it is not issued
# by GitHub. Without it the webhook endpoint refuses every payload with a 503,
# because an unverifiable payload is never processed.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=
# URL slug of the GitHub App, used to build the "install DevProof" link shown
# when a user has authorized but not yet installed it. Optional.
GITHUB_APP_SLUG=your-github-app-slug

FRONTEND_URL=http://localhost:5173

# Free key from https://console.groq.com. Without it the server still boots —
# AI insights requests just fail with a clear 503 rather than the whole app
# refusing to start.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
