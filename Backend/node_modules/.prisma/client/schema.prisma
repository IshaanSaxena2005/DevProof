generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  DEVELOPER
  RECRUITER
  ADMIN
}

enum AnalysisStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SeverityLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  GOOD
}

enum MetricCategory {
  ENGINEERING_HEALTH
  CODE_QUALITY
  SECURITY
  TESTING
  MAINTAINABILITY
  DOCUMENTATION
  DEPENDENCY_HEALTH
}

enum EvidenceLevel {
  CLAIMED
  LEARNED
  CREDENTIAL_VERIFIED
  PRACTICALLY_EVIDENCED
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  TESTING
  DEVOPS
  SECURITY
  ML
  GENERAL
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String?
  avatarUrl    String?
  role         UserRole @default(DEVELOPER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  githubAccount   GitHubAccount?
  repositories    Repository[]
  analyses        RepositoryAnalysis[]
  skills          Skill[]
  courses         Course[]
  certifications  Certification[]
  codingProfiles  CodingProfile[]
  targetRoles     TargetRole[]
  analysisHistory AnalysisHistory[]

  @@map("users")
}

model GitHubAccount {
  id             String   @id @default(uuid())
  userId         String   @unique
  githubId       String   @unique
  username       String
  accessToken    String
  profileUrl     String?
  avatarUrl      String?
  totalRepos     Int      @default(0)
  totalStars     Int      @default(0)
  totalFollowers Int      @default(0)
  linkedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_accounts")
}

model Repository {
  id              String   @id @default(uuid())
  githubAccountId String?
  userId          String
  name            String
  fullName        String
  owner           String
  url             String
  description     String?
  isPrivate       Boolean  @default(false)
  defaultBranch   String   @default("main")
  language        String?
  starsCount      Int      @default(0)
  forksCount      Int      @default(0)
  sizeKb          Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses        RepositoryAnalysis[]
  analysisHistory AnalysisHistory[]

  @@map("repositories")
}

model RepositoryAnalysis {
  id           String         @id @default(uuid())
  repositoryId String
  userId       String
  status       AnalysisStatus @default(PENDING)
  overallScore Float          @default(0.0)
  healthStatus String         @default("NEEDS_REVIEW")
  rawResults   Json?
  errorMessage String?
  analyzedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics    Metric[]
  findings   Finding[]

  @@map("repository_analyses")
}

model Metric {
  id         String         @id @default(uuid())
  analysisId String
  category   MetricCategory
  name       String
  score      Float
  detail     String?

  analysis RepositoryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("metrics")
}

model Finding {
  id             String        @id @default(uuid())
  analysisId     String
  severity       SeverityLevel
  category       String
  title          String
  description    String
  filePath       String?
  lineNumber     Int?
  snippet        String?
  recommendation String?

  analysis RepositoryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("findings")
}

model Skill {
  id           String        @id @default(uuid())
  userId       String
  name         String
  category     SkillCategory @default(GENERAL)
  confidence   Float         @default(0.0)
  currentLevel EvidenceLevel @default(CLAIMED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidences SkillEvidence[]

  @@map("skills")
}

model SkillEvidence {
  id           String        @id @default(uuid())
  skillId      String
  evidenceType String
  sourceUrl    String?
  title        String
  snippet      String?
  level        EvidenceLevel @default(PRACTICALLY_EVIDENCED)
  createdAt    DateTime      @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@map("skill_evidences")
}

model Course {
  id             String   @id @default(uuid())
  userId         String
  title          String
  platform       String
  isCompleted    Boolean  @default(false)
  certificateUrl String?
  learnedSkills  Json?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("courses")
}

model Certification {
  id            String    @id @default(uuid())
  userId        String
  name          String
  issuer        String
  credentialId  String?
  credentialUrl String?
  issueDate     DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model CodingProfile {
  id           String   @id @default(uuid())
  userId       String
  platform     String
  handle       String
  totalSolved  Int      @default(0)
  easySolved   Int      @default(0)
  mediumSolved Int      @default(0)
  hardSolved   Int      @default(0)
  rating       Float?
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coding_profiles")
}

model TargetRole {
  id             String   @id @default(uuid())
  userId         String
  roleName       String
  readinessScore Float    @default(0.0)
  skillGaps      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]

  @@map("target_roles")
}

model Recommendation {
  id           String   @id @default(uuid())
  targetRoleId String
  title        String
  description  String
  priority     String   @default("MEDIUM")
  category     String   @default("GENERAL")
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())

  targetRole TargetRole @relation(fields: [targetRoleId], references: [id], onDelete: Cascade)

  @@map("recommendations")
}

model AnalysisHistory {
  id           String   @id @default(uuid())
  repositoryId String
  userId       String
  score        Float
  summary      String?
  createdAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analysis_histories")
}
